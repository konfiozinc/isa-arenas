#!/bin/sh
# Pre-commit hook: bloquea Google API Keys y patrones de secreto en commits nuevos.
# Claves publicas de Firebase permitidas (publicas por diseno, protegidas por
# Security Rules y restringidas por referrer en Google Cloud):
#   - konfio-zinc   (analitica Firestore de la agencia)
#   - el-titi-menu  (proyecto compartido de menus y catalogos)
#   - isa-arenas    (proyecto dedicado de Calzados ISA Arenas)
KNOWN_KEYS="AIzaSyDbwAk9APwP2SeaEfWxeQG_bdL9eatciEA AIzaSyDHWE3OJMspi_z0CKPv8mjvjI7igum98rs AIzaSyDWGO2YtkELMRTYYSb4Rq2Mc40dpyMQYso"

# Solo lineas ANADIDAS (sin contexto) para evitar falsos positivos por lineas vecinas.
added=$(git diff --cached --diff-filter=ACM -U0 | grep -E '^\+[^+]' | grep -oE 'AIza[0-9A-Za-z_-]{35}' | sort -u)

if [ -n "$added" ]; then
  for key in $added; do
    case " $KNOWN_KEYS " in
      *" $key "*) ;;
      *)
        echo ""
        echo "ERROR: Se detecto una Google API Key no permitida en este commit: $key"
        echo "  Si es una key publica de Firebase, agregala a KNOWN_KEYS en .githooks/pre-commit."
        echo "  Si es un secreto real, muevelo fuera del repositorio."
        exit 1
        ;;
    esac
  done
fi

# Patrones de secreto genericos en lineas anadidas
if git diff --cached --diff-filter=ACM -U0 | grep -E '^\+[^+]' | grep -Eq "(api[_-]?key|secret|password|token)[[:space:]]*[:=][[:space:]]*['\"][A-Za-z0-9_-]{20,}"; then
  echo ""
  echo "ADVERTENCIA: Posible secreto detectado en el commit. Revisalo antes de continuar."
  exit 1
fi

exit 0
